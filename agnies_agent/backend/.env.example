# Copy to backend/.env and fill in real values. Never commit the real .env.

# Django
# Generate with: python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits+'!@#$%^&*(-_=+)') for _ in range(50)))"
DJANGO_SECRET_KEY=
# True for local dev, False in production
DJANGO_DEBUG=False
# Comma-separated, e.g. manojshendre.com,140.245.8.248
DJANGO_ALLOWED_HOSTS=

# Sandbox root the negotiation pipeline writes generated task code into.
# Linux path on the server, e.g. /home/opc/agnies_sandbox
SANDBOX_ROOT=

# Gemini (grounded fact search)
GEMINI_KEY=
GROUNDING_MODEL=gemini:gemini-2.5-flash-lite

# Anthropic (Prime/role models)
ANTHROPIC_API_KEY=
PRIME_MODEL=anthropic:claude-sonnet-5
ROLE_MODEL=anthropic:claude-sonnet-5

# NVIDIA (unused unless PRIME_MODEL/ROLE_MODEL point at nvidia:*)
NVIDIA_API_KEY=
GROQ_API_KEY=
